<?xml version="1.0"?>
<description xmlns="http://cpee.org/ns/description/1.0" xmlns:a="http://cpee.org/ns/annotation/1.0">
  <call id="a1" endpoint="" a:alt_id="1">
    <parameters>
      <label>Check Service Necessity</label>
      <method/>
      <arguments/>
    </parameters>
  </call>
  <choose label="{x}" mode="exclusive" a:alt_id="2" eid="e1">
    <alternative condition="No Service Needed" eid="e12" language="text/x-ruby"/>
    <otherwise eid="e2">
      <call id="a5" endpoint="" a:alt_id="3">
        <parameters>
          <label>Check Registration</label>
          <method/>
          <arguments/>
        </parameters>
      </call>
      <choose label="{x}" mode="exclusive" a:alt_id="4" eid="e3">
        <alternative condition="Registered" eid="e4" language="text/x-ruby">
          <call id="a11" endpoint="" a:alt_id="5">
            <parameters>
              <label>Notify Owner</label>
              <method/>
              <arguments/>
            </parameters>
          </call>
          <parallel wait="-1" cancel="last" a:alt_id="6" eid="e5">
            <parallel_branch eid="e6">
              <call id="a17" endpoint="" a:alt_id="7">
                <parameters>
                  <label>Wait for Service</label>
                  <method/>
                  <arguments/>
                </parameters>
              </call>
              <call id="a21" endpoint="" a:alt_id="9">
                <parameters>
                  <label>Mechanic Enters Problems</label>
                  <method/>
                  <arguments/>
                </parameters>
              </call>
              <call id="a23" endpoint="" a:alt_id="10">
                <parameters>
                  <label>Send Status Updates</label>
                  <method/>
                  <arguments/>
                </parameters>
              </call>
            </parallel_branch>
            <parallel_branch eid="e7">
              <call id="a19" endpoint="" a:alt_id="8">
                <parameters>
                  <label>Monitor 30 Days</label>
                  <method/>
                  <arguments/>
                </parameters>
              </call>
            </parallel_branch>
          </parallel>
          <choose label="{x}" mode="exclusive" a:alt_id="12" eid="e8">
            <alternative condition="Service Not Done" eid="e9" language="text/x-ruby">
              <call id="a31" endpoint="" a:alt_id="13">
                <parameters>
                  <label>Issue Fine</label>
                  <method/>
                  <arguments/>
                </parameters>
              </call>
            </alternative>
            <alternative condition="Service Done" eid="e10" language="text/x-ruby">
              <call id="a33" endpoint="" a:alt_id="14">
                <parameters>
                  <label>Process Payment</label>
                  <method/>
                  <arguments/>
                </parameters>
              </call>
              <call id="a37" endpoint="" a:alt_id="17">
                <parameters>
                  <label>Enter Repair Success and Pickerl</label>
                  <method/>
                  <arguments/>
                </parameters>
              </call>
              <call id="a39" endpoint="" a:alt_id="18">
                <parameters>
                  <label>Enter Next Service Date</label>
                  <method/>
                  <arguments/>
                </parameters>
              </call>
            </alternative>
          </choose>
        </alternative>
        <alternative condition="Not Registered" eid="e11" language="text/x-ruby"/>
      </choose>
    </otherwise>
  </choose>
</description>

<?xml version="1.0"?>
<description xmlns="http://cpee.org/ns/description/1.0" xmlns:a="http://cpee.org/ns/annotation/1.0">
  <call id="a1" endpoint="" a:alt_id="1">
    <parameters>
      <label>Read order from system</label>
      <method/>
      <arguments/>
    </parameters>
  </call>
  <call id="a3" endpoint="" a:alt_id="2">
    <parameters>
      <label>Initialize product selection</label>
      <method/>
      <arguments/>
    </parameters>
  </call>
  <loop mode="pre_test" condition="true" eid="e1">
    <call id="a7" endpoint="" a:alt_id="4">
      <parameters>
        <label>Check if product in stock</label>
        <method/>
        <arguments/>
      </parameters>
    </call>
    <choose label="{x}" mode="exclusive" a:alt_id="5" eid="e2">
      <alternative condition="In stock" eid="e3" language="text/x-ruby">
        <call id="a11" endpoint="" a:alt_id="6">
          <parameters>
            <label>Withdraw from warehouse</label>
            <method/>
            <arguments/>
          </parameters>
        </call>
      </alternative>
      <alternative condition="Not in stock" eid="e4" language="text/x-ruby">
        <call id="a13" endpoint="" a:alt_id="7">
          <parameters>
            <label>Reorder from wholesaler</label>
            <method/>
            <arguments/>
          </parameters>
        </call>
        <choose label="{x}" mode="exclusive" a:alt_id="8" eid="e5">
          <alternative condition="Delay &gt; 10 days" eid="e6" language="text/x-ruby">
            <call id="a17" endpoint="" a:alt_id="9">
              <parameters>
                <label>Demand delivery penalty</label>
                <method/>
                <arguments/>
              </parameters>
            </call>
          </alternative>
          <alternative condition="Delay &lt;= 10 days" eid="e7" language="text/x-ruby"/>
        </choose>
        <call id="a19" endpoint="" a:alt_id="10">
          <parameters>
            <label>Wait for arrival</label>
            <method/>
            <arguments/>
          </parameters>
        </call>
        <call id="a23" endpoint="" a:alt_id="11">
          <parameters>
            <label>Register product in stock</label>
            <method/>
            <arguments/>
          </parameters>
        </call>
      </alternative>
    </choose>
    <call id="a29" endpoint="" a:alt_id="13">
      <parameters>
        <label>Check if order ready</label>
        <method/>
        <arguments/>
      </parameters>
    </call>
    <choose label="{x}" mode="exclusive" a:alt_id="14" eid="e8">
      <alternative condition="Not ready" eid="e9" language="text/x-ruby">
        <call id="a35" endpoint="" a:alt_id="16">
          <parameters>
            <label>Select next product</label>
            <method/>
            <arguments/>
          </parameters>
        </call>
      </alternative>
      <alternative condition="Ready" eid="e10" language="text/x-ruby">
        <parallel wait="-1" cancel="last" a:alt_id="15" eid="e11">
          <parallel_branch eid="e12">
            <call id="a39" endpoint="" a:alt_id="17">
              <parameters>
                <label>Request courier</label>
                <method/>
                <arguments/>
              </parameters>
            </call>
          </parallel_branch>
          <parallel_branch eid="e13">
            <call id="a41" endpoint="" a:alt_id="18">
              <parameters>
                <label>Pack products</label>
                <method/>
                <arguments/>
              </parameters>
            </call>
          </parallel_branch>
        </parallel>
        <call id="a47" endpoint="" a:alt_id="20">
          <parameters>
            <label>Ship order</label>
            <method/>
            <arguments/>
          </parameters>
        </call>
        <escape a:alt_id="-1"/>
      </alternative>
    </choose>
  </loop>
</description>

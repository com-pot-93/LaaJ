{
    "tasks": [
        {
            "id": "a1",
            "name": "ACME AG receives invoices",
            "type": "Task"
        },
        {
            "id": "a2",
            "name": "Secretariat performs invoice's visual inspection",
            "type": "Task"
        },
        {
            "id": "a3",
            "name": "Secretariat forwards the invoice to an accounting employee",
            "type": "Task"
        },
        {
            "id": "a4",
            "name": "Accounting employee identifies the charging suppliers",
            "type": "Task"
        },
        {
            "id": "a5",
            "name": "Accounting employee creates a new invoice",
            "type": "Task"
        },
        {
            "id": "a6",
            "name": "Accounting employee checks the invoice items",
            "type": "Task"
        },
        {
            "id": "a7",
            "name": "Accounting employee notes the  cost center and the cost center managers (docket)",
            "type": "Task"
        },
        {
            "id": "a34",
            "name": "Docket and the invoice's copy go to the internal mail",
            "type": "Task"
        },
        {
            "id": "a8",
            "name": "Accounting employee  sends the docket and the invoice copy to the  cost center manager",
            "type": "Task"
        },
        {
            "id": "a35",
            "name": "Cost center manager receives the copy of the invoice",
            "type": "Task"
        },
        {
            "id": "a9",
            "name": "Cost center manager reviews the content for accuracy",
            "type": "Task"
        },
        {
            "id": "a11",
            "name": "Cost center manager notes his code one on  the docket (AP)",
            "type": "Task"
        },
        {
            "id": "a12",
            "name": "Cost center manager returns the copy of the invoice",
            "type": "Task"
        },
        {
            "id": "a13",
            "name": "Pass the copy of the invoice to the next cost center manager",
            "type": "Task"
        },
        {
            "id": "a14",
            "name": "Cost center manager  sends invoice back to accounting",
            "type": "Task"
        },
        {
            "id": "a16",
            "name": "Accounting employee proceedes with the clarification with the vendor",
            "type": "Task"
        },
        {
            "id": "a19",
